{
  "regions": [
    "cdg1"
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/stages?purge=1",
      "schedule": "0 4 * * *"
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/avis",
      "destination": "/api/stages?_route=avis"
    },
    {
      "source": "/api/instagram-image",
      "destination": "/api/instagram?_route=image"
    }
  ]
}
