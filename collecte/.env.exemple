# Copier ce fichier en .env dans le même dossier, puis renseigner la clé.
# Le .env n'est jamais versionné : il est listé dans .gitignore.

# Clé de dépôt. La même valeur doit être posée dans les variables
# d'environnement Vercel sous le nom FFBB_INGEST_CLE.
# Elle ne permet que de remplacer des données FFBB publiques : elle ne donne
# aucun accès aux inscriptions aux stages.
FFBB_INGEST_CLE=a_remplacer

# Où déposer. À ne changer que pour tester contre un autre déploiement.
MBC_INGEST_URL=https://api.morieres-basket.club/api/ingest

# Pause entre deux appels à la FFBB, en millisecondes. Sept requêtes
# simultanées depuis la même adresse ressemblent à un robot : on espace.
FFBB_PAUSE_ENTRE_APPELS=900
